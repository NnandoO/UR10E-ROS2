  m_Name: 
  m_EditorClassIdentifier: 
  pasos:
  - titulo: "Paso 1 \xB7 Inserci\xF3n de instrumentos"
    descripcion: "Toma el Grasper y la Tijera de la mesa con el GATILLO (\xEDndice)
      e introd\xFAcelos por los trocares. Observa el efecto fulcro: el instrumento
      pivota en el punto de entrada."
    audio: {fileID: 0}
    zonaAnatomica: {fileID: 1343574155}
    radioZona: 0.03
    modeloFantasma: {fileID: 1423093450}
    trayectoriaFantasma:
    - {fileID: 260786462}
    - {fileID: 1343574155}
    duracionTrayectoria: 4
    condicion: 2
    herramientaReal: {fileID: 3585950}
    tiempoPaso: 6
    tiempoEnZona: 1
  - titulo: "Paso 2 \xB7 Tracci\xF3n del fondo vesicular"
    descripcion: "Lleva el Grasper al fondo de la ves\xEDcula y pulsa el GRIP (dedo
      medio) para sujetarla. Tracciona hacia arriba y hacia el hombro derecho del
      paciente para exponer el hilio."
    audio: {fileID: 0}
    zonaAnatomica: {fileID: 629607526}
    radioZona: 0.015
    modeloFantasma: {fileID: 1423093450}
    trayectoriaFantasma:
    - {fileID: 1343574155}
    - {fileID: 629607526}
    duracionTrayectoria: 3
    condicion: 2
    herramientaReal: {fileID: 3585950}
    tiempoPaso: 6
    tiempoEnZona: 1
  - titulo: "Paso 3 \xB7 Tri\xE1ngulo de Calot y corte c\xEDstico"
    descripcion: "Exp\xF3n el tri\xE1ngulo de Calot. Con la Tijera, pulsa el GRIP
      sobre el conducto y la arteria c\xEDsticos (previamente clipados) para seccionarlos."
    audio: {fileID: 0}
    zonaAnatomica: {fileID: 4770510}
    radioZona: 0.015
    modeloFantasma: {fileID: 2121425440}
    trayectoriaFantasma:
    - {fileID: 956495849}
    - {fileID: 857267547}
    - {fileID: 4770510}
    duracionTrayectoria: 5
    condicion: 2
    herramientaReal: {fileID: 1047266571}
    tiempoPaso: 6
    tiempoEnZona: 1
  - titulo: "Paso 4 \xB7 Disecci\xF3n, liberaci\xF3n y extracci\xF3n"
    descripcion: "Diseca la ves\xEDcula del lecho hep\xE1tico de abajo hacia arriba,
      lib\xE9rala por completo y extr\xE1ela por el trocar."
