  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"OpenRST\" type=\"system\">\r\n  <hardware>\r\n   
    <plugin>openrst_control/OpenRSTSystemHardware</plugin>\r\n  </hardware>\r\n 
    <joint name=\"joint_pitch\">\r\n    <command_interface name=\"effort\" />\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n    <state_interface name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"joint_finger_left\">\r\n   
    <command_interface name=\"effort\" />\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface name=\"effort\"
    />\r\n  </joint>\r\n  <joint name=\"joint_finger_right\">\r\n    <command_interface
    name=\"effort\" />\r\n    <state_interface name=\"position\" />\r\n    <state_interface
    name=\"velocity\" />\r\n    <state_interface name=\"effort\" />\r\n  </joint>\r\n</ros2_control>"
